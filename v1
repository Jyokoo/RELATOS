<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Malla Galáctica - Optimizada</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Thasadith:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            user-select: none;
            background-color: #03020d;
            overflow: hidden;
        }

        body.modo-activo {
            cursor: crosshair !important;
        }

        .thasadith-regular {
            font-family: "Thasadith", sans-serif;
            font-weight: 400;
            font-style: normal;
        }

        /* =====================================================================
           1. ORBES CON GRADIENTE RADIAL (0% COSTO DE BLUR EN GPU)
           ===================================================================== */
        .orb-base {
            position: absolute;
            border-radius: 50%;
            will-change: transform;
            transform: translateZ(0);
            transition: opacity 1.2s ease;
        }

        .orb-1 {
            top: -20%; left: -10%; width: 70vw; height: 70vw;
            background: radial-gradient(circle, rgba(90,24,154,0.65) 0%, rgba(36,0,70,0.25) 45%, transparent 72%);
            animation: mesh-float-1 22s ease-in-out infinite;
        }
        .orb-2 {
            top: 25%; right: -15%; width: 65vw; height: 65vw;
            background: radial-gradient(circle, rgba(0,180,216,0.55) 0%, rgba(3,4,94,0.25) 45%, transparent 72%);
            animation: mesh-float-2 28s ease-in-out infinite;
        }
        .orb-3 {
            bottom: -25%; left: 10%; width: 75vw; height: 75vw;
            background: radial-gradient(circle, rgba(247,37,133,0.5) 0%, rgba(114,9,183,0.25) 45%, transparent 72%);
            animation: mesh-float-3 25s ease-in-out infinite;
        }
        .orb-4 {
            top: 5%; left: 20%; width: 55vw; height: 55vw;
            background: radial-gradient(circle, rgba(0,245,212,0.4) 0%, rgba(77,25,77,0.2) 45%, transparent 72%);
            animation: mesh-float-4 32s ease-in-out infinite;
        }
        .orb-5 {
            bottom: 15%; right: 15%; width: 60vw; height: 60vw;
            background: radial-gradient(circle, rgba(106,4,15,0.55) 0%, rgba(15,16,38,0.25) 45%, transparent 72%);
            animation: mesh-float-5 20s ease-in-out infinite;
        }

        /* En Pantalla 2: fondo azulado oscuro estático/ligero para priorizar 60fps en ondas y cámara */
        .screen-2-active .orb-base {
            animation-play-state: paused !important;
            opacity: 0.25 !important;
        }
        .screen-2-active .bg-screen-2 {
            opacity: 1 !important;
        }

        .bg-screen-2 {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 50% 45%, #06183a 0%, #020818 55%, #010208 100%);
            opacity: 0;
            transition: opacity 1.2s ease;
            pointer-events: none;
        }

        @keyframes mesh-float-1 {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(10vw, -12vh, 0) scale(1.15); }
        }
        @keyframes mesh-float-2 {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(-12vw, 10vh, 0) scale(1.1); }
        }
        @keyframes mesh-float-3 {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(8vw, 14vh, 0) scale(0.95); }
        }
        @keyframes mesh-float-4 {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(-14vw, -10vh, 0) scale(1.2); }
        }
        @keyframes mesh-float-5 {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(12vw, -6vh, 0) scale(1.08); }
        }

        @keyframes pulse-twinkle {
            0%, 100% { opacity: var(--base-opacity, 0.25); }
            50% { opacity: calc(var(--base-opacity, 0.25) * 1.35); }
        }

        @keyframes rotation-slow {
            from { transform: rotate(var(--initial-rotation, 0deg)) translateZ(0); }
            to { transform: rotate(calc(var(--initial-rotation, 0deg) + 360deg)) translateZ(0); }
        }

        @keyframes star-glow-twinkle {
            0%, 100% { opacity: 0.2; transform: scale(0.8); }
            50% { opacity: 0.95; transform: scale(1.25); }
        }

        @keyframes title-glow-twinkle {
            0%, 100% {
                opacity: 0.8;
                text-shadow: 0 0 14px rgba(255, 255, 255, 0.3);
            }
            50% {
                opacity: 1;
                text-shadow: 0 0 24px rgba(255, 255, 255, 0.7), 0 0 42px rgba(180, 210, 255, 0.4);
            }
        }

        .constellation { will-change: transform, opacity; }
        .rotate-slow-alegr { animation: pulse-twinkle 12s ease-in-out infinite, rotation-slow 200s linear infinite; }
        .rotate-slow-anxi { animation: pulse-twinkle 14s ease-in-out infinite, rotation-slow 240s linear infinite; }
        .rotate-slow-rag { animation: pulse-twinkle 10s ease-in-out infinite, rotation-slow 180s linear infinite; }

        /* Pausar constelaciones y estrellas en Pantalla 2 para cero consumo en segundo plano */
        .paused-layer * {
            animation-play-state: paused !important;
        }

        .star-point {
            position: absolute;
            background-color: #ffffff;
            border-radius: 50%;
            box-shadow: 0 0 5px rgba(255, 255, 255, 0.8);
            animation: star-glow-twinkle var(--duration, 4s) ease-in-out infinite;
            animation-delay: var(--delay, 0s);
        }

        .title-glow {
            animation: title-glow-twinkle 7s ease-in-out infinite;
        }

        /* =====================================================================
           2. ONDAS VECTORIALES OPTIMIZADAS (SIN FILTROS PESADOS POR FRAME)
           ===================================================================== */
        .panel-figuras {
            position: fixed;
            bottom: 28px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 18px;
            z-index: 100;
            align-items: center;
            transition: opacity 0.6s ease, transform 0.6s ease;
        }

        .panel-oculto {
            opacity: 0;
            pointer-events: none;
            transform: translate(-50%, 24px);
        }

        .btn-figura {
            background: transparent;
            border: none;
            padding: 6px;
            cursor: pointer;
            opacity: 0.45;
            transform: scale(0.95);
            transition: opacity 0.25s ease, transform 0.25s ease;
        }

        .btn-figura:hover {
            opacity: 0.85;
            transform: scale(1.04);
        }

        .btn-figura.activo {
            opacity: 1;
            transform: scale(1.12);
            filter: drop-shadow(0 0 10px rgba(255, 220, 0, 0.7));
        }

        .btn-figura img {
            width: 60px;
            height: auto;
            display: block;
            pointer-events: none;
        }

        .ripple {
            position: fixed;
            width: 140px;
            height: 140px;
            pointer-events: none;
            transform: translate3d(-50%, -50%, 0) scale(0.15);
            transform-origin: center center;
            animation: expandRipple 2.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            will-change: transform, opacity;
            overflow: visible;
            z-index: 25;
            contain: layout style;
        }

        .ripple-path {
            fill: none;
            stroke: currentColor;
            stroke-miterlimit: 10;
            stroke-width: 3.5px;
            vector-effect: non-scaling-stroke;
        }

        .miedo-path-sub {
            fill: none;
            stroke: currentColor;
            stroke-miterlimit: 10;
            stroke-width: 1.5px;
            opacity: 0.45;
            vector-effect: non-scaling-stroke;
        }

        @keyframes expandRipple {
            0% {
                opacity: 0.95;
                transform: translate3d(-50%, -50%, 0) scale(0.15) rotate(0deg);
            }
            100% {
                opacity: 0;
                transform: translate3d(-50%, -50%, 0) scale(6.2) rotate(22deg);
            }
        }

        /* =====================================================================
           3. PANEL DE CÁMARA
           ===================================================================== */
        #cam-ui {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 100;
            width: 215px;
            font-family: system-ui, -apple-system, sans-serif;
            color: #fff;
            transition: opacity 0.6s ease, transform 0.6s ease;
        }
        #cam-ui.cam-oculto {
            opacity: 0;
            pointer-events: none;
            transform: translateY(-16px);
        }
        #cam-ui .glass {
            background: rgba(10, 8, 30, 0.78);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 14px;
            padding: 10px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        }
        #cam-ui button {
            width: 100%;
            border-radius: 9px;
            padding: 7px 10px;
            font-size: 12px;
            background: rgba(255, 255, 255, 0.14);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            cursor: pointer;
            transition: background 0.2s;
        }
        #cam-ui button:hover:not(:disabled) {
            background: rgba(255, 255, 255, 0.24);
        }
        #cam-ui button:disabled {
            opacity: 0.6;
            cursor: default;
        }
        #cam-wrap {
            position: relative;
            margin-top: 8px;
            border-radius: 9px;
            overflow: hidden;
            background: #000;
        }
        #cam-wrap video, #cam-wrap canvas {
            display: block;
            width: 100%;
        }
        #cam-overlay {
            position: absolute;
            inset: 0;
        }
        .chip {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            opacity: 0.45;
            transition: opacity 0.15s, background 0.15s;
            padding: 2px 4px;
            border-radius: 6px;
        }
        .chip i {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            display: inline-block;
        }
        .chip-on {
            opacity: 1;
            background: rgba(255, 255, 255, 0.18);
            font-weight: 600;
        }
    </style>
</head>
<body id="main-body" class="min-h-screen w-screen overflow-hidden m-0 p-0 relative cursor-pointer">

    <!-- Fondo Galáctico Optimizado -->
    <div id="mesh-container" class="fixed inset-0 w-full h-full pointer-events-none overflow-hidden">
        <div class="orb-base orb-1"></div>
        <div class="orb-base orb-2"></div>
        <div class="orb-base orb-3"></div>
        <div class="orb-base orb-4"></div>
        <div class="orb-base orb-5"></div>
        <div class="bg-screen-2"></div>

        <!-- CAPA DE ESTRELLAS -->
        <div id="stars-layer" class="absolute inset-0 z-0 pointer-events-none transition-opacity duration-700">
            <span class="star-point w-0.5 h-0.5 top-[15%] left-[22%]" style="--duration: 3.5s; --delay: 0.2s;"></span>
            <span class="star-point w-1 h-1 top-[28%] left-[12%]" style="--duration: 5.1s; --delay: 1.5s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[8%] left-[35%]" style="--duration: 4.0s; --delay: 2.8s;"></span>
            <span class="star-point w-1 h-1 top-[38%] left-[5%]" style="--duration: 3.2s; --delay: 0.7s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[10%] left-[65%]" style="--duration: 4.2s; --delay: 0.8s;"></span>
            <span class="star-point w-1 h-1 top-[22%] left-[82%]" style="--duration: 5.8s; --delay: 2.1s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[12%] left-[85%]" style="--duration: 3.9s; --delay: 2.2s;"></span>
            <span class="star-point w-1.5 h-1.5 top-[5%] left-[50%]" style="--duration: 6.5s; --delay: 1.2s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[30%] left-[92%]" style="--duration: 4.6s; --delay: 3.1s;"></span>
            <span class="star-point w-1.5 h-1.5 top-[22%] left-[45%]" style="--duration: 4.0s; --delay: 2.5s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[35%] left-[32%]" style="--duration: 3.2s; --delay: 1.8s;"></span>
            <span class="star-point w-1 h-1 top-[48%] left-[48%]" style="--duration: 5.2s; --delay: 0.4s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[52%] left-[62%]" style="--duration: 3.7s; --delay: 1.9s;"></span>
            <span class="star-point w-1 h-1 top-[40%] left-[25%]" style="--duration: 4.8s; --delay: 2.9s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[75%] left-[18%]" style="--duration: 3.8s; --delay: 3.0s;"></span>
            <span class="star-point w-1 h-1 top-[55%] left-[15%]" style="--duration: 6.2s; --delay: 3.4s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[88%] left-[8%]" style="--duration: 4.3s; --delay: 0.5s;"></span>
            <span class="star-point w-1 h-1 top-[68%] left-[30%]" style="--duration: 5.0s; --delay: 1.6s;"></span>
            <span class="star-point w-1 h-1 top-[85%] left-[45%]" style="--duration: 4.7s; --delay: 1.1s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[60%] left-[70%]" style="--duration: 5.5s; --delay: 0.4s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[80%] left-[88%]" style="--duration: 4.5s; --delay: 0.9s;"></span>
            <span class="star-point w-1 h-1 top-[72%] left-[78%]" style="--duration: 3.6s; --delay: 2.7s;"></span>
            <span class="star-point w-0.5 h-0.5 top-[92%] left-[60%]" style="--duration: 4.1s; --delay: 1.4s;"></span>
            <span class="star-point w-1 h-1 top-[65%] left-[94%]" style="--duration: 5.7s; --delay: 0.1s;"></span>
        </div>

        <!-- CAPA DE CONSTELACIONES SVG -->
        <div id="constellations-layer" class="absolute inset-0 z-10 pointer-events-none overflow-hidden transition-opacity duration-700">
            <img src="img/constelaciones/alegr.svg" alt="Constelación Alegr" class="absolute -top-[15%] -left-[12%] w-[50vw] max-w-[620px] opacity-25 constellation rotate-slow-alegr mix-blend-screen" style="--base-opacity: 0.25; --initial-rotation: 0deg;" />
            <img src="img/constelaciones/anxi.svg" alt="Constelación Anxi" class="absolute -top-[16%] -right-[15%] w-[58vw] max-w-[750px] opacity-20 constellation rotate-slow-anxi mix-blend-screen" style="--base-opacity: 0.20; --initial-rotation: -12deg;" />
            <img src="img/constelaciones/rag.svg" alt="Constelación Rag" class="absolute -bottom-[22%] left-[20%] md:left-[28%] w-[54vw] max-w-[700px] opacity-30 constellation rotate-slow-rag mix-blend-screen" style="--base-opacity: 0.30; --initial-rotation: 6deg;" />
        </div>

        <!-- CAPA DE TEXTO CENTRAL -->
        <div id="title-layer" class="absolute inset-0 z-20 flex items-center justify-center pointer-events-none px-6 text-center transition-opacity duration-700">
            <h1 class="thasadith-regular title-glow text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-wider leading-tight max-w-4xl">
                Coloca tu figura seleccionada aquí
            </h1>
        </div>
    </div>

    <!-- BOTÓN VOLVER AL INICIO (Pantalla 2) -->
    <button id="home-btn" class="thasadith-regular fixed top-6 left-6 z-50 px-6 py-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white/90 hover:text-white border border-white/25 opacity-0 pointer-events-none transition-opacity duration-500 tracking-wider">
        ← Volver al inicio
    </button>

    <!-- PANEL DE CÁMARA Y DETECCIÓN GEOMÉTRICA (Pantalla 2) -->
    <div id="cam-ui" class="cam-oculto">
        <div class="glass">
            <button id="cam-start">Activar cámara</button>
            <button id="cam-flip" class="hidden" style="margin-top:6px">Cambiar cámara</button>
            <div id="cam-preview" class="hidden transition-opacity">
                <div id="cam-wrap">
                    <video id="cam-video" playsinline muted></video>
                    <canvas id="cam-overlay"></canvas>
                </div>
            </div>
            <p id="cam-status" style="font-size:11px;margin:8px 0 2px;opacity:.85">Activa la cámara para detectar geometría 3D</p>
            <p id="cam-verts" style="font-size:10px;margin:0 0 6px;color:#00f5d4;font-family:monospace">Vértices: --</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px">
                <div class="chip" data-emo="alegria"><i style="background:rgb(255,205,25)"></i>Alegría</div>
                <div class="chip" data-emo="ansiedad"><i style="background:rgb(255,105,30)"></i>Ansiedad</div>
                <div class="chip" data-emo="asco"><i style="background:rgb(140,210,35)"></i>Asco</div>
                <div class="chip" data-emo="ira"><i style="background:rgb(235,35,60)"></i>Ira</div>
                <div class="chip" data-emo="miedo"><i style="background:rgb(165,130,235)"></i>Miedo</div>
                <div class="chip" data-emo="tristeza"><i style="background:rgb(35,120,255)"></i>Tristeza</div>
            </div>
            <button id="cam-toggle" style="margin-top:8px;font-size:11px">Mostrar / ocultar vista</button>
        </div>
    </div>

    <!-- PANEL INFERIOR DE FIGURAS (Pantalla 2) -->
    <nav class="panel-figuras panel-oculto" id="panelFiguras"></nav>

    <script>
        // =========================================================================
        // 1. NAVEGACIÓN ENTRE PANTALLAS (Pausando capas ocultas para 60fps)
        // =========================================================================
        let isSecondScreen = false;

        const body = document.getElementById('main-body');
        const meshContainer = document.getElementById('mesh-container');
        const starsLayer = document.getElementById('stars-layer');
        const constellationsLayer = document.getElementById('constellations-layer');
        const titleLayer = document.getElementById('title-layer');
        const homeBtn = document.getElementById('home-btn');
        const panelFiguras = document.getElementById('panelFiguras');
        const camUi = document.getElementById('cam-ui');

        body.addEventListener('click', () => {
            if (isSecondScreen) return;
            isSecondScreen = true;

            body.classList.remove('cursor-pointer');
            body.classList.add('cursor-default');
            meshContainer.classList.add('screen-2-active');

            starsLayer.classList.add('opacity-0', 'paused-layer');
            constellationsLayer.classList.add('opacity-0', 'paused-layer');
            titleLayer.classList.add('opacity-0', 'paused-layer');

            homeBtn.classList.remove('opacity-0', 'pointer-events-none');
            homeBtn.classList.add('opacity-100', 'pointer-events-auto');
            panelFiguras.classList.remove('panel-oculto');
            camUi.classList.remove('cam-oculto');
        });

        homeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            isSecondScreen = false;

            seleccionarEmocion(null);

            body.classList.remove('cursor-default');
            body.classList.add('cursor-pointer');
            meshContainer.classList.remove('screen-2-active');

            starsLayer.classList.remove('opacity-0', 'paused-layer');
            constellationsLayer.classList.remove('opacity-0', 'paused-layer');
            titleLayer.classList.remove('opacity-0', 'paused-layer');

            homeBtn.classList.remove('opacity-100', 'pointer-events-auto');
            homeBtn.classList.add('opacity-0', 'pointer-events-none');
            panelFiguras.classList.add('panel-oculto');
            camUi.classList.add('cam-oculto');
        });

        // =========================================================================
        // 2. CONFIGURACIÓN DE EMOCIONES Y ONDAS VECTORIALES (SVG OPTIMIZADO)
        // =========================================================================
        const EMOCIONES = {
            tristeza: {
                nombre: 'Tristeza',
                figuraSrc: 'figuras/tristeza.svg',
                rgb: [35, 120, 255],
                colorConfig: { hueMin: 205, hueMax: 265, satMin: 80, satMax: 95, lightMin: 52, lightMax: 74 },
                ondaSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 369.21 278.18" class="ripple"><path class="ripple-path" d="M183.78,276.68c-9.72,0-19.76-5.61-30-16.76-14.53-15.84-33.59-26.02-53.68-28.68-18.65-2.47-45.21-8.38-65.79-22.53C10.98,192.66,0,169.6,1.67,140.17c1.38-24.37,10.86-40.48,28.96-49.26,15.5-7.51,34.56-8.37,51.38-9.13,8.63-.39,16.77-.76,23.16-2.03,9.02-1.79,18.74-6.19,28.89-13.06,10.66-7.22,18.38-17.39,26.56-28.15,3.45-4.54,7.02-9.24,10.8-13.64,13.09-15.26,27.36-23.13,42.4-23.4.27,0,.53,0,.8,0,21.54,0,40.27,15.39,52.25,28.4,8.52,9.25,19.2,16,30.87,19.52,13.87,4.18,26.91,10.7,38.76,19.38,18.24,13.37,29.84,35.67,31.02,59.65.36,7.35.23,14.44-.4,21.09-1.87,19.87-10.84,37.85-25.26,50.63-12.9,11.44-28.86,17.57-45.45,17.57-1.9,0-3.8-.08-5.71-.24-48.9-4.14-62.68,16.57-74.84,34.84-6.14,9.22-11.94,17.94-21.65,22.12-3.43,1.48-6.91,2.21-10.43,2.22Z"/></svg>`
            },
            miedo: {
                nombre: 'Miedo',
                figuraSrc: 'figuras/miedo.svg',
                rgb: [165, 130, 235],
