                        const i = row + x;
                        const n = mask[i - w - 1] + mask[i - w] + mask[i - w + 1] +
                                  mask[i - 1]     + mask[i]     + mask[i + 1] +
                                  mask[i + w - 1] + mask[i + w] + mask[i + w + 1];
