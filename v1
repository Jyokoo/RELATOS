            function hull(pts) {
                const copy = pts.slice().sort((a, b) => a[0] - b[0] || a[1] - b[1]);
                const cr = (o, a, b) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
                const lo = [], up = [];
                for (const p of copy) { while (lo.length >= 2 && cr(lo[lo.length - 2], lo[lo.length - 1], p) <= 0) lo.pop(); lo.push(p); }
                for (let i = copy.length - 1; i >= 0; i--) { const p = copy[i]; while (up.length >= 2 && cr(up[up.length - 2], up[up.length - 1], p) <= 0) up.pop(); up.push(p); }
