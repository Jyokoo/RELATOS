                for (let k = 0; k < n; k++) { const i = idx[k]; sx += i % w; sy += (i / w) | 0; }
                const cx = sx / n, cy = sy / n;
                let a = 0, b = 0, c = 0, x0 = 1e9, x1 = -1, y0 = 1e9, y1 = -1;
                for (let k = 0; k < n; k++) {
                    const i = idx[k], px = i % w, py = (i / w) | 0, dx = px - cx, dy = py - cy;
                    a += dx * dx; b += dx * dy; c += dy * dy;
                    if (px < x0) x0 = px; if (px > x1) x1 = px; if (py < y0) y0 = py; if (py > y1) y1 = py;
                }
                a /= n; b /= n; c /= n;
                const tr = a + c, det = Math.max(1e-9, a * c - b * b), s = Math.sqrt(det), t = Math.sqrt(tr + 2 * s);
                const ia = (c + s) / (s * t), ib = -b / (s * t), ic = (a + s) / (s * t);
                let m30 = 0, m03 = 0, m21 = 0, m12 = 0;
                const rad = new Float64Array(NANG), bpts = [];

                for (let k = 0; k < n; k++) {
                    const i = idx[k], px = i % w, py = (i / w) | 0, dx = px - cx, dy = py - cy;
                    const u = ia * dx + ib * dy, v = ib * dx + ic * dy;
                    m30 += u * u * u; m03 += v * v * v; m21 += u * u * v; m12 += u * v * v;
                    let ang = Math.atan2(v, u); if (ang < 0) ang += 2 * Math.PI;
                    const bi = Math.min(NANG - 1, (ang / (2 * Math.PI) * NANG) | 0), r = Math.hypot(u, v);
                    if (r > rad[bi]) rad[bi] = r;
                    if (!mask[i - 1] || !mask[i + 1] || !mask[i - w] || !mask[i + w]) bpts.push([px, py]);
                }

                const n30 = m30 / n, n03 = m03 / n, n21 = m21 / n, n12 = m12 / n;
                const h3 = (n30 - 3 * n12) ** 2 + (3 * n21 - n03) ** 2;
                const h4 = (n30 + n12) ** 2 + (n21 + n03) ** 2;
                let mr = 0; for (let i = 0; i < NANG; i++) mr += rad[i]; mr /= NANG;

                const fd = [];
                for (let k = 0; k < NHARM; k++) {
                    let re = 0, im = 0;
                    const cRow = COS_TAB[k], sRow = SIN_TAB[k];
                    for (let i = 0; i < NANG; i++) {
                        re += rad[i] * cRow[i];
                        im += rad[i] * sRow[i];
                    }
                    fd.push(Math.hypot(re, im) / (NANG * mr + 1e-9));
                }

                const hl = hull(bpts);
                const sol = hl.length > 2 ? Math.min(1, n / polyArea(hl)) : 1;
                const bbox = [x0, y0, x1, y1];
                const vertices = extractVertices(bpts, cx, cy, bbox);
                const lg = v => Math.log10(Math.abs(v) + 1e-9);

                return { area: n, cx, cy, bbox, vertices, f: { h3: lg(h3), h4: lg(h4), sol, fd } };
            }

            function segment(rgba, w, h, minArea, maxFrac) {
                maxFrac = maxFrac || 0.55;
                const total = w * h;
                const gray = new Uint8Array(total);
                const hist = new Int32Array(256);

                for (let i = 0; i < total; i++) {
                    const o = i << 2;
                    const g = (77 * rgba[o] + 150 * rgba[o + 1] + 29 * rgba[o + 2]) >> 8;
                    gray[i] = g;
                    hist[g]++;
                }

                let sum = 0;
                for (let t = 0; t < 256; t++) sum += t * hist[t];
                let sumB = 0, wB = 0, wF = 0, varMax = 0, threshold = 128;
                for (let t = 0; t < 256; t++) {
                    wB += hist[t];
                    if (wB === 0) continue;
                    wF = total - wB;
                    if (wF === 0) break;
                    sumB += t * hist[t];
                    const mB = sumB / wB;
                    const mF = (sum - sumB) / wF;
                    const varBetween = wB * wF * (mB - mF) * (mB - mF);
                    if (varBetween > varMax) { varMax = varBetween; threshold = t; }
                }

                let borderSum = 0, borderCount = 0;
                for (let x = 0; x < w; x++) { borderSum += gray[x] + gray[(h - 1) * w + x]; borderCount += 2; }
                for (let y = 0; y < h; y++) { borderSum += gray[y * w] + gray[y * w + (w - 1)]; borderCount += 2; }
                const lightBg = (borderSum / borderCount) > threshold;

                const raw = new Uint8Array(total);
                for (let i = 0; i < total; i++) {
                    raw[i] = lightBg ? (gray[i] < threshold ? 1 : 0) : (gray[i] > threshold ? 1 : 0);
                }

                const mask = majority(majority(raw, w, h), w, h);
                const seen = new Uint8Array(total);
                const parts = [];

                for (let s = 0; s < total; s++) {
                    if (!mask[s] || seen[s]) continue;
                    const stack = [s], idx = [];
                    seen[s] = 1;
                    let touchesBorder = false;

                    while (stack.length) {
                        const i = stack.pop();
                        idx.push(i);
                        const x = i % w, y = (i / w) | 0;
                        if (x === 0 || x === w - 1 || y === 0 || y === h - 1) touchesBorder = true;

                        if (x > 0 && mask[i - 1] && !seen[i - 1]) { seen[i - 1] = 1; stack.push(i - 1); }
                        if (x < w - 1 && mask[i + 1] && !seen[i + 1]) { seen[i + 1] = 1; stack.push(i + 1); }
                        if (y > 0 && mask[i - w] && !seen[i - w]) { seen[i - w] = 1; stack.push(i - w); }
                        if (y < h - 1 && mask[i + w] && !seen[i + w]) { seen[i + w] = 1; stack.push(i + w); }
                    }

                    if (!touchesBorder && idx.length >= minArea && idx.length <= total * maxFrac) {
                        parts.push(describe(idx, w, h, mask));
                    }
                }
                return parts;
            }

            const WT = { h3: 1.04, h4: 0.2, sol: 0.06, fd: 5.5 };
            function featDist(a, b) {
                let f = 0;
                for (let k = 0; k < NHARM; k++) f += Math.abs(a.fd[k] - b.fd[k]);
                return WT.h3 * Math.abs(a.h3 - b.h3) + WT.h4 * Math.abs(a.h4 - b.h4) + WT.sol * Math.abs(a.sol - b.sol) + WT.fd * f;
            }

            function classify(blobs, refs, maxDist, margin) {
                const out = []; margin = margin || 0;
                for (const b of blobs) {
                    const ds = Object.keys(refs).map(e => ({ e, d: Math.min(...refs[e].map(r => featDist(b.f, r))) })).sort((x, y) => x.d - y.d);
                    if (ds[0].d <= maxDist && (ds.length < 2 || ds[1].d - ds[0].d >= margin)) {
                        out.push({
                            emotion: ds[0].e,
                            dist: ds[0].d,
                            area: b.area,
                            cx: b.cx,
                            cy: b.cy,
                            bbox: b.bbox,
                            vertices: b.vertices
                        });
                    }
                }
                return out;
            }

            // 180px de ancho: ~3.2x más rápido que 320px manteniendo la misma precisión geométrica
            const MAX_DIST = 1.45, W = 180;
            const video = document.getElementById('cam-video');
            const overlay = document.getElementById('cam-overlay');
            const octx = overlay.getContext('2d');
            const work = document.createElement('canvas');
            const wctx = work.getContext('2d', { willReadFrequently: true });
            const statusEl = document.getElementById('cam-status');
            const vertsEl = document.getElementById('cam-verts');
            const btnStart = document.getElementById('cam-start');
            const btnFlip = document.getElementById('cam-flip');
            const preview = document.getElementById('cam-preview');
            const chips = {};
            document.querySelectorAll('[data-emo]').forEach(el => chips[el.dataset.emo] = el);

            let stream = null, facing = 'environment', mirrored = false, running = false;
            const hits = {}, pos = {}, lastEmit = {};
            Object.keys(EMOCIONES).forEach(k => { hits[k] = 0; lastEmit[k] = 0; });

            async function startCamera() {
                try {
                    statusEl.textContent = 'Solicitando cámara…';
                    if (stream) stream.getTracks().forEach(t => t.stop());
                    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: facing }, width: { ideal: 320 }, height: { ideal: 240 } }, audio: false });
                    video.srcObject = stream; await video.play();
                    const st = stream.getVideoTracks()[0].getSettings();
                    mirrored = st.facingMode ? st.facingMode === 'user' : facing === 'user' || !/Android|iPhone|iPad/i.test(navigator.userAgent);
                    video.style.transform = overlay.style.transform = mirrored ? 'scaleX(-1)' : 'none';
                    preview.classList.remove('hidden');
                    btnStart.textContent = 'Cámara activa'; btnStart.disabled = true;
                    btnFlip.classList.remove('hidden');
                    statusEl.textContent = 'Muestra un modelo 3D a la cámara';
                    if (!running) { running = true; tick(); }
                } catch (err) {
                    console.error(err);
                    statusEl.textContent = 'No se pudo abrir la cámara';
                }
            }

            function drawGeometry(verts, rgb) {
                if (!verts || verts.length < 3) return;
                const [r, g, b] = rgb;
                octx.strokeStyle = `rgba(${r},${g},${b}, 0.9)`;
                octx.fillStyle = `rgba(${r},${g},${b}, 0.18)`;
                octx.lineWidth = 1.4;
                octx.beginPath();
                octx.moveTo(verts[0][0], verts[0][1]);
                for (let i = 1; i < verts.length; i++) octx.lineTo(verts[i][0], verts[i][1]);
                octx.closePath();
                octx.fill();
                octx.stroke();

                octx.fillStyle = '#ffffff';
                for (const [vx, vy] of verts) {
                    octx.fillRect(vx - 1.5, vy - 1.5, 3, 3);
                }
            }

            function tick() {
                if (isSecondScreen && video.readyState >= 2 && video.videoWidth) {
                    const w = W, h = Math.round(W * video.videoHeight / video.videoWidth);
                    if (work.width !== w || work.height !== h) { work.width = w; work.height = h; overlay.width = w; overlay.height = h; }
                    wctx.drawImage(video, 0, 0, w, h);
                    const frame = wctx.getImageData(0, 0, w, h);

                    const blobs = segment(frame.data, w, h, Math.round(w * h * 0.008));
                    const found = {};
                    for (const d of classify(blobs, REF_3D, MAX_DIST)) {
                        if (!found[d.emotion] || d.area > found[d.emotion].area) found[d.emotion] = d;
                    }

                    const now = performance.now();
                    octx.clearRect(0, 0, w, h);

                    if (Object.keys(found).length === 0 && blobs.length > 0) {
                        const biggest = blobs.reduce((a, b) => a.area > b.area ? a : b);
                        drawGeometry(biggest.vertices, [0, 245, 212]);
                        vertsEl.textContent = `Vértices detectados: ${biggest.vertices.length}`;
                    }

                    for (const k of Object.keys(EMOCIONES)) {
                        const d = found[k];
                        if (d) hits[k] = Math.min(6, hits[k] + 1);
                        else   hits[k] = Math.max(0, hits[k] - 2);

                        const on = hits[k] >= 4;
                        chips[k].classList.toggle('chip-on', on);

                        if (d && on) {
                            const p = pos[k] || (pos[k] = { x: d.cx, y: d.cy });
                            p.x += (d.cx - p.x) * 0.5; p.y += (d.cy - p.y) * 0.5;

                            drawGeometry(d.vertices, EMOCIONES[k].rgb);
                            if (emocionActivaKey !== k) seleccionarEmocion(k);

                            let nx = p.x / w; if (mirrored) nx = 1 - nx;
                            const ny = p.y / h;
                            if (now - lastEmit[k] > 550) {
                                createRipple(nx * window.innerWidth, ny * window.innerHeight, true, k);
                                lastEmit[k] = now;
                            }

                            statusEl.textContent = 'Forma: ' + EMOCIONES[k].nombre;
                            vertsEl.textContent = `Vértices: ${d.vertices.length}`;
                        } else if (!on) {
                            delete pos[k];
                        }
                    }

                    const active = Object.keys(EMOCIONES).some(k => hits[k] >= 4);
                    if (!active) {
                        statusEl.textContent = 'Muestra un modelo 3D a la cámara';
                        if (blobs.length === 0) vertsEl.textContent = 'Vértices: 0';
                    }
                }
                setTimeout(tick, 140);
            }

            btnStart.addEventListener('click', (e) => { e.stopPropagation(); startCamera(); });
            btnFlip.addEventListener('click', (e) => { e.stopPropagation(); facing = facing === 'environment' ? 'user' : 'environment'; startCamera(); });
            document.getElementById('cam-toggle').addEventListener('click', (e) => { e.stopPropagation(); preview.classList.toggle('opacity-0'); });
        })();
    </script>

</body>
